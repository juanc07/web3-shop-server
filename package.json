{
  "name": "online-shop-server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start:simple": "node dist/server.js",
    "dev:simple": "nodemon src/server.ts",
    "serve": "node --require ./dist/env.js dist/server.js",
    "start": "npm run serve:prod",
    "start:dev": "cross-env NODE_ENV=development node --require ./dist/env.js dist/server.js",
    "start:prod": "cross-env NODE_ENV=production node --require ./dist/env.js dist/server.js",
    "dev": "concurrently \"tsc -w\" \"cross-env NODE_ENV=development nodemon --watch dist --require ./dist/env.js dist/server.js\"",
    "clean": "pnpm store prune && rm -rf node_modules pnpm-lock.yaml && pnpm install",
    "create-ata": "cross-env NODE_ENV=development node --require ./dist/env.js dist/scripts/create-ata.js",
    "migrateProduct": "cross-env NODE_ENV=development node --require ./dist/env.js dist/scripts/migrateProduct.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.5.2",
  "dependencies": {
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.14.1",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "bs58": "^6.0.0",
    "cloudinary": "^2.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-fileupload": "^1.5.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.2",
    "multer": "1.4.5-lts.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/express-fileupload": "^1.5.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "cross-env": "^7.0.3"
  }
}
