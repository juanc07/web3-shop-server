# Environment variables
.env
.env.local
.env.development
.env.test
.env.production
.env.*  # Ignores any file starting with .env.

# Qodo AI tool directory
.qodo/

# Node.js and pnpm
node_modules/
pnpm-lock.yaml  # pnpm lock file (optional, include if not versioned)
pnpm-debug.log*

# TypeScript
dist/
build/
out/
*.tsbuildinfo  # TypeScript build info files
coverage/  # Test coverage reports

# Logs (restored specific patterns)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# MongoDB
*.bson  # MongoDB dump files
*.mongodb  # MongoDB local data files
data/  # Common MongoDB local data directory (adjust if custom path used)

# Build and bundle output
public/build/
.esbuild/
webpack/
rollup/

# Dependency directories
bower_components/

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating system files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
*.swp
*~

# Sensitive files
*.key
*.pem
*.cert
secrets.json
config.json
credentials.json
*.envrc

# Testing
*.lcov
junit.xml
test-results/

# Docker (if used)
Dockerfile.dev
*.dockerignore
docker-compose.yml  # Optional, include if not versioned